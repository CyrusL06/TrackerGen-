# Core TrackerGen server
MONGODB_URI=mongodb://127.0.0.1:27017/trackergen
AUTH_MODE=offline
OFFLINE_USER_ID=local-user
OFFLINE_USER_EMAIL=local@example.com
WORKOS_COOKIE_PASSWORD=replace_with_a_long_random_secret_32_plus_chars
CSRF_SECRET=replace_with_a_different_long_random_secret
FRONTEND_ORIGIN=http://localhost:5173

# RBC email tracking. Leave EMAIL_INGESTION_DOMAIN empty to keep the feature disabled.
EMAIL_INGESTION_DOMAIN=inbox.example.com
EMAIL_INGESTION_SECRET=replace_with_a_random_32_byte_or_longer_secret_never_commit_it
# Use the exact sender domain observed in a real, verified RBC purchase alert.
RBC_EMAIL_ALLOWED_DOMAINS=alerts.example.rbc-domain
# Keep true in production. Disabling this removes sender-authentication enforcement.
EMAIL_REQUIRE_AUTH_PASS=true
EMAIL_TRANSACTION_TIME_ZONE=America/Vancouver
